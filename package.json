{
  "name": "light-ledger",
  "version": "0.1.0",
  "description": "轻账 · Windows 本地记账工具",
  "main": "./out/main/index.js",
  "author": "you",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,electron -c blue,green \"npm run server:dev\" \"electron-vite dev\"",
    "dev:clean": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 5210 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }; G[...]",
    "server:dev": "tsx src/server/index.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx,js,jsx}\"",
    "format": "prettier --write \"{src,docs}/**/*.{ts,tsx,js,jsx,json,md,css,scss}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^5.21.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "sql.js": "^1.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.10"
  }
}
